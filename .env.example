# Entra ID app registration (public client, delegated permissions)
OneDrive__TenantId=
OneDrive__ClientId=

# Key Flow Weaver sends as X-API-Key. Generate one, e.g. PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
OneDrive__ApiKey=

# true = only read tools (list/search/get/read) and the login asks for Files.Read
OneDrive__ReadOnly=false
OneDrive__AllowAnonymousLinks=false
OneDrive__MaxReadBytes=1048576
OneDrive__MaxUploadBytes=4194304
